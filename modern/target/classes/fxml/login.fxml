<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" styleClass="anchor-pane" 
             xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <VBox alignment="CENTER" layoutX="200.0" layoutY="100.0" prefHeight="400.0" prefWidth="400.0" spacing="20.0">
        <padding>
            <Insets top="40.0" right="40.0" bottom="40.0" left="40.0"/>
        </padding>
        
        <!-- Title -->
        <Label styleClass="label-title" text="AndKasir Desktop" alignment="CENTER"/>
        <Label styleClass="label-subtitle" text="Point of Sale System v2.0" alignment="CENTER"/>
        
        <!-- Form Fields -->
        <VBox spacing="15.0">
            <VBox spacing="5.0">
                <Label text="Username:" styleClass="label-info"/>
                <TextField fx:id="usernameField" promptText="Masukkan username"/>
            </VBox>
            
            <VBox spacing="5.0">
                <Label text="Password:" styleClass="label-info"/>
                <PasswordField fx:id="passwordField" promptText="Masukkan password"/>
            </VBox>
            
            <!-- Status Label -->
            <Label fx:id="statusLabel" wrapText="true" prefHeight="40.0"/>
            
            <!-- Progress Bar -->
            <ProgressBar fx:id="progressBar" prefWidth="400.0" visible="false"/>
        </VBox>
        
        <!-- Login Button -->
        <Button fx:id="loginButton" text="LOGIN" prefWidth="400.0" prefHeight="45.0" 
                onAction="#handleLogin"/>
        
        <!-- Links -->
        <HBox alignment="CENTER" spacing="10.0">
            <Hyperlink fx:id="forgotPasswordLink" text="Lupa Password?" onAction="#handleForgotPassword"/>
        </HBox>
        
        <!-- Version Info -->
        <Label fx:id="versionLabel" styleClass="label-subtitle" alignment="CENTER"/>
        
    </VBox>
    
    <!-- Background Elements -->
    <StackPane layoutX="50.0" layoutY="50.0" prefWidth="100.0" prefHeight="100.0" 
             style="-fx-background-color: rgba(0, 120, 212, 0.1); -fx-background-radius: 50px;"/>
    <StackPane layoutX="650.0" layoutY="450.0" prefWidth="150.0" prefHeight="150.0" 
             style="-fx-background-color: rgba(0, 120, 212, 0.05); -fx-background-radius: 75px;"/>
    
</AnchorPane>